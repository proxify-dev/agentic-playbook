{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./service-account.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "./.env",
        "./.env.*",
        "./service-account.json"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "./.env",
          "mode": "deny"
        },
        {
          "path": "./service-account.json",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "APP_API_TOKEN",
          "mode": "deny"
        }
      ]
    }
  }
}
